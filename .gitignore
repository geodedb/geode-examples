*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# Go
*.exe
*.exe~
*.dll
*.dylib
*.test
*.out
go.work

# Rust
Cargo.lock
debug/
target/

# Node
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Reports and outputs
reports/
public/
*.log

# Certificates (keep templates)
certs/*.crt
certs/*.key
certs/*.pem
!certs/.gitkeep

# Docker volumes
.docker-data/

# Benchmark results
benchmarks/results/*.json
benchmarks/results/*.csv

# Temporary files
*.tmp
*.temp
.cache/

# Environment files
.env
.env.local
.env.*.local

# Coverage
.coverage
htmlcov/
.pytest_cache/
