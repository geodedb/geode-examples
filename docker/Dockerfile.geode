# Geode Database Server Container
# Uses pre-built binary for faster container builds
#
# Build context should be the geode repository root:
#   docker build -f docker/Dockerfile.geode -t geodedb/geode:latest ../geode

# Runtime image
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -s /bin/false geode \
    && mkdir -p /var/lib/geode /var/log/geode /certs \
    && chown -R geode:geode /var/lib/geode /var/log/geode /certs

# Copy pre-built Geode binary
COPY zig-out/bin/geode /usr/local/bin/geode

# Health check script
RUN echo '#!/bin/sh\ngeode query --server localhost:3141 --insecure "RETURN 1" >/dev/null 2>&1' > /usr/local/bin/healthcheck.sh \
    && chmod +x /usr/local/bin/healthcheck.sh \
    && chmod +x /usr/local/bin/geode

USER geode

WORKDIR /var/lib/geode

# Expose ports:
# 3141 - QUIC server port
# 9090 - Prometheus metrics
EXPOSE 3141 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/healthcheck.sh"]

ENTRYPOINT ["geode"]
CMD ["serve", "--data-dir", "/var/lib/geode", "--listen", "0.0.0.0:3141", "--log-level", "info"]
